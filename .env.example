# Talk to @BotFather -> /newbot -> copy the token here
BOT_TOKEN=123456:ABC-YOUR-TOKEN-HERE

# Your numeric Telegram user id. Get it from @userinfobot.
# The bot ignores everyone else.
OWNER_ID=0

# IANA timezone used for every reminder and scheduled scan
TZ=Europe/Dublin

# Docker only: must match the owner of ./data or the bot cannot write its
# database. Run `id -u` and `id -g` and paste the numbers in.
PUID=1000
PGID=1000

# Optional
DB_PATH=data/universe.db
LOG_LEVEL=INFO
