# Talk to @BotFather -> /newbot -> copy the token here
BOT_TOKEN=123456:ABC-YOUR-TOKEN-HERE

# Your numeric Telegram user id (from @userinfobot). You are the admin:
# you get failure alerts, the Users screen and the backups.
OWNER_ID=0

# How many people may register. Everyone else is politely turned away.
MAX_USERS=50

# Fallback timezone for a brand-new user before they pick their own.
# Times are stored in UTC; each person's own zone is asked on /start.
TZ=Europe/Dublin

# Docker only: must match the owner of ./data or the bot cannot write its
# database. Run `id -u` and `id -g` and paste the numbers in.
PUID=1000
PGID=1000

# Optional
DB_PATH=data/universe.db
LOG_LEVEL=INFO
